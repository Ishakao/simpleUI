string(REPLACE "|" ";" CANDIDATES "${CANDIDATES}")
if(EXISTS "${LIBDIR}/${CANON}")
    return()
endif()
foreach(c ${CANDIDATES})
    if(EXISTS "${LIBDIR}/${c}")
        file(COPY_FILE "${LIBDIR}/${c}" "${LIBDIR}/${CANON}")
        return()
    endif()
endforeach()
message(FATAL_ERROR "none of ${CANDIDATES} found in ${LIBDIR}")
